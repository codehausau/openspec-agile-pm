{
  "name": "openspec-agile-pm",
  "version": "0.8.1",
  "description": "Approval-gated product discovery and capability PRDs for OpenSpec",
  "type": "module",
  "bin": {
    "openspec-agile-pm": "bin/cli.js"
  },
  "files": [
    "assets/",
    "bin/",
    "lib/",
    "CHANGELOG.md",
